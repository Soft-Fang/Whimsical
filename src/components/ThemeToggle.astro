<!-- 明暗主题切换按钮组件 -->
<button
  id="theme-toggle"
  class="p-1.5 rounded-full hover:bg-fg/10 transition-colors"
  aria-label="切换明暗主题"
>
  <svg id="sun-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg id="moon-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('sun-icon');
  const moon = document.getElementById('moon-icon');

  function updateIcon(theme) {
    if (theme === 'dark') {
      sun?.classList.add('hidden');
      moon?.classList.remove('hidden');
    } else {
      sun?.classList.remove('hidden');
      moon?.classList.add('hidden');
    }
  }

  // 初始化图标
  const current = document.documentElement.getAttribute('data-theme');
  updateIcon(current);

  // 事件委托：ClientRouter 切页会替换按钮节点，挂到 document 上更稳
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target?.closest('#theme-toggle')) return;
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateIcon(next);
    // 通知其他组件（如 WallpaperPicker）主题已切换
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
  });

  // 切页后新按钮的图标需要跟随当前主题
  document.addEventListener('astro:after-swap', () => {
    updateIcon(document.documentElement.getAttribute('data-theme'));
  });
</script>