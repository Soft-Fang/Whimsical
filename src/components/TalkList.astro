---
// 今日说法列表组件：卡片显示正文前 20 字，点击进入详情大卡片
import { getCollection } from 'astro:content';
import AnimateIn from './AnimateIn.astro';

const talks = (await getCollection('talk')).sort(
  (a, b) => (b.data.update ?? '').localeCompare(a.data.update ?? ''),
);

// 从 markdown 正文提取纯文本，去掉图片/链接语法和多余空白，截取前 n 个字
function excerpt(body: string | undefined, n = 20) {
  const text = (body ?? '')
    .replace(/!\[.*?\]\(.*?\)/g, ' ')    // 图片语法
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')  // 链接语法
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > n ? text.slice(0, n) + '…' : text;
}
---

<div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
  <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">TALK / 碎碎念</p>
  <h1 class="text-3xl font-bold mb-6">今日说法</h1>
  <hr class="border-fg/10 mb-8" />

  {talks.length === 0 ? (
    <p class="text-fg/50">还没有说说。</p>
  ) : (
    <div class="flex flex-col gap-4">
      {talks.map((talk, i) => (
        <AnimateIn delay={i * 80}>
          <a
            href={import.meta.env.BASE_URL + 'talk/' + encodeURIComponent(talk.id)}
            class="block group transition-all duration-300 hover:-translate-y-0.5"
          >
            <div class="rounded-2xl border border-fg/10 bg-bg/50 backdrop-blur-md p-5
                        hover:bg-bg/70 hover:border-accent/30 transition-colors duration-200">
              <p class="text-base font-medium text-fg/80 group-hover:text-accent
                        transition-colors duration-200 leading-relaxed">
                {excerpt(talk.body)}
              </p>
              {talk.data.update && (
                <time class="block mt-3 text-xs text-fg/35 font-mono">{talk.data.update}</time>
              )}
            </div>
          </a>
        </AnimateIn>
      ))}
    </div>
  )}
</div>
