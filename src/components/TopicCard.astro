---
interface Props {
  href: string;
  name: string;
  image?: string;
}
const { href, name, image } = Astro.props;
---
<a href={href} class="group block rounded-2xl overflow-hidden ring-1 ring-fg/10 bg-bg/60 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/5">
  {image ? <img src={image} alt={name} class="w-full h-32 object-cover" loading="lazy" /> : null}
  <div class="px-4 py-3">
    <h2 class="text-base font-bold text-fg group-hover:text-accent transition-colors">{name}</h2>
  </div>
</a>