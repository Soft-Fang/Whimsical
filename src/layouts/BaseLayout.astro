---
//默认布局，所有页面都必须套上这个布局，不然壁纸和导航栏功能不能正常工作
import '../styles/global.css';
import { site } from '../site.config';
import ThemeToggle from '../components/ThemeToggle.astro';
import WallpaperPicker from '../components/WallpaperPicker.astro';

const {
  title,
  ogType = 'website',
  ogDescription = site.description,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${site.name}` : site.defaultTitle;
// SEO 使用的站点域名（site.url 留空时用占位域名）
const siteUrl = site.url || 'https://example.com';
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const link = (href: string) => base + href.replace(/^\/+/, '');

function navClass(href: string) {
  const full = base + href.replace(/^\/+/, '');
  const isActive = currentPath === full || currentPath === href || currentPath === full + '/' || currentPath === href + '/';
  return isActive
    ? 'text-accent bg-accent/10 font-medium'
    : 'text-fg/60 hover:text-accent hover:bg-fg/5';
}
---
 

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
   
    <meta name="description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(site.ogImage, siteUrl).href} />
    <meta property="og:site_name" content={site.ogSiteName} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL(site.ogImage, siteUrl).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
   
    <link rel="icon" type="image/png" href={link('/favicon.png')} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.1.0/style.css" />
    <title>{pageTitle}</title>

  <script is:inline>
  // 更改网页图标的配置代码在这里，默认使用favicon.png名字和格式图片， <link rel="icon" type="image/png" href="/favicon.png" />
 
 
  // ===== 第一层：首屏防闪（FOUC）=====
  // 必须在 head 里同步执行，在浏览器画第一帧之前设好主题
  (function () {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();

  // ===== 第二层：ClientRouter 切页防闪 =====
  // ClientRouter 导航后不重跑 inline 脚本，
  // 必须监听 astro:after-swap 事件，在新页面渲染前重新设主题
  function applyTheme() {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  }
  document.addEventListener('astro:after-swap', applyTheme);
  </script>
  </head>

  <body data-base={base} class="bg-bg text-fg min-h-screen flex flex-col">
      <div id="reading-progress" transition:persist="reading-progress" style="position:fixed;left:0;top:0;bottom:0;width:5px;z-index:80;pointer-events:none;background:color-mix(in srgb,var(--c-fg) 10%,transparent)">
    <div id="progress-fill" style="position:absolute;left:0;top:0;width:100%;height:0;background:linear-gradient(to bottom,#7C6CFF,#60A5FA,#3DA48F,#F5C542,#F06292)"></div>
  </div>
  <canvas id="click-particles" transition:persist="click-particles" style="position:fixed;inset:0;pointer-events:none;z-index:70"></canvas>
  <div id="oml2d-host" transition:persist="oml2d-host"></div>
  <div id="nikke-host" transition:persist="nikke-host" style="position:fixed;right:0;bottom:0;width:360px;height:540px;z-index:64;visibility:hidden;transform-origin:right bottom"></div>
        <div id="mascot-toggle" transition:persist="mascot-toggle" style="position:fixed;left:14px;bottom:14px;z-index:10000">
    <div style="display:flex;gap:6px;align-items:center;background:rgba(0,0,0,.3);backdrop-filter:blur(6px);border-radius:999px;padding:5px 8px;box-shadow:0 2px 8px rgba(0,0,0,.25)">
      <button id="btn-live2d" type="button" title="Live2D" aria-label="Live2D" style="cursor:pointer;border:none;border-radius:50%;width:16px;height:16px;background:#F06292;opacity:1"></button>
      <button id="btn-viper" type="button" title="Spine" aria-label="Spine" style="cursor:pointer;border:none;border-radius:50%;width:16px;height:16px;background:#A855F7;opacity:0.45"></button>
      <button id="btn-chars" type="button" title="切换角色" style="cursor:pointer;border:none;border-radius:50%;width:16px;height:16px;background:#FBBF24;opacity:0.9"></button>
    </div>
  </div>
  <div id="mascot-min-popup" transition:persist="mascot-min-popup" style="position:fixed;right:14px;bottom:14px;z-index:10001;display:none;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);border-radius:10px;padding:8px 12px;color:#fff;font-size:12px">窗口过小，看板娘已隐藏</div>
  <div id="char-panel" transition:persist="char-panel" style="position:fixed;left:14px;bottom:52px;z-index:10000;display:none;flex-direction:column;gap:4px;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);border-radius:12px;padding:6px"></div>
    <!-- 全宽导航条：logo 在最左，导航+主题/壁纸在最右，中间留空 -->
    <header class="sticky top-4 z-50">
      <div class="flex items-center justify-between w-full px-20 py-4
                  bg-bg/15 backdrop-blur-2xl
                  shadow-lg shadow-black/5
                  text-lg
                  max-md:gap-3 max-md:px-4 max-md:py-2 max-md:text-sm">
        <a href={base} class:list={['px-3 py-1.5 max-md:px-2.5 max-md:py-1 rounded-full transition-all duration-200', navClass('/')]}>{site.name}</a>

        <!-- 右侧：桌面导航 + 主题/壁纸（整体靠右） -->
        <div class="flex items-center gap-1">
          <!-- 桌面导航（md 及以上横排显示，仅导航链接） -->
          <nav class="hidden md:flex items-center gap-1">
            {site.nav.map((item) => (
              <a href={link(item.href)} data-nav={item.href} class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass(item.href)]}>{item.label}</a>
            ))}
          </nav>
          <ThemeToggle />
          <WallpaperPicker />
          <!-- 汉堡按钮：仅手机显示 -->
          <button
            id="menu-btn"
            class="md:hidden p-1.5 rounded-full hover:bg-fg/10 transition-colors"
            aria-label="打开菜单"
            aria-expanded="false"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 手机端下拉菜单：放在 header 外，避免毛玻璃 backdrop-filter 影响 fixed 定位 -->
    <div
      id="mobile-menu"
      class="md:hidden fixed top-24 right-4 z-[60] w-56
             bg-bg/85 backdrop-blur-xl
             rounded-2xl shadow-xl shadow-black/10
             ring-1 ring-fg/10
             scale-95 opacity-0 pointer-events-none
             transition-all duration-200 ease-out
             flex flex-col p-2"
    >
      {site.nav.map((item) => (
        <a
          href={link(item.href)} data-nav={item.href}
          class:list={['px-3 py-2.5 rounded-xl text-sm transition-colors', navClass(item.href)]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- slot 是"页面内容插入的洞"：layout 提供外壳，页面的内容填进这里 -->
    <main class="flex-1">
      <slot />
    </main>
    <footer class="px-8 py-6 border-t border-fg/10 text-sm opacity-60">
      {site.name}
    </footer>

  <script>
    // ===== 手机端汉堡菜单（事件委托 + 动态查询，ClientRouter 切页后依然有效） =====
    let menuOpen = false;

    function getMenu() {
      return document.getElementById('mobile-menu');
    }

    function setMenu(open: boolean) {
      menuOpen = open;
      const menu = getMenu();
      if (!menu) return;
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('scale-95', !open);
      menu.classList.toggle('pointer-events-none', !open);
      menu.classList.toggle('opacity-100', open);
      menu.classList.toggle('scale-100', open);
      const btn = document.getElementById('menu-btn');
      if (btn) btn.setAttribute('aria-expanded', String(open));
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      // 点汉堡按钮：切换开合
      if (target?.closest('#menu-btn')) {
        setMenu(!menuOpen);
        return;
      }
      // 点菜单里的链接：关闭
      if (target?.closest('#mobile-menu a')) {
        setMenu(false);
        return;
      }
      // 点外部空白：关闭
      if (menuOpen && !target?.closest('#mobile-menu')) {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) setMenu(false);
    });
  </script>

  
<script>
  const aboutLinks = document.querySelectorAll('a[data-nav="/about"]');
  const basePath = document.body.dataset.base || '/';
  let aboutTimer = null;
  aboutLinks.forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      if (aboutTimer) {
        clearTimeout(aboutTimer);
        aboutTimer = null;
        window.location.href = basePath + 'private';
      } else {
        aboutTimer = setTimeout(function () {
          aboutTimer = null;
          window.location.href = a.getAttribute('href');
        }, 280);
      }
    });
  });
</script>  
        <!-- 看板娘双系统切换：Live2D / Viper(Spine) + 角色切换 -->
  <script is:inline>
    (function () {
      var MODE_KEY = 'mascot_mode';
      var L2D_BASE_SCALE = 0.05625;
      var NIKKE_BASE_H = 540;

                  var L2D_MODELS = [
        { name: '大凤', path: 'https://cdn.jsdelivr.net/gh/Eikanya/Live2d-model@master/%E7%A2%A7%E8%93%9D%E8%88%AA%E7%BA%BF%20Azue%20Lane/Azue%20Lane%28JP%29/dafeng_3/dafeng_3.model3.json' }
      ];
            var NIKKE_CHARS = [
        { name: '毒蛇', id: 'c112' },
        { name: '拉毗', id: 'c010' },
        { name: '黑兔', id: 'c271' },
        { name: '白兔', id: 'c270' },
        { name: '白雪公主', id: 'c220' },
        { name: '红莲', id: 'c222' }
      ];
      var NIKKE_CUR = 'c112';

      function getMode() { try { return localStorage.getItem(MODE_KEY) || 'live2d'; } catch (e) { return 'live2d'; } }
      function setMode(m) {
        try { localStorage.setItem(MODE_KEY, m); } catch (e) {}
        applyMode();
        hideCharPanel();
        if (m === 'live2d') { ensureLive2D(); } else { ensureNikke(); }
      }

      function rawFactor() {
        var w = window.innerWidth || 1200;
        var h = window.innerHeight || 800;
        return Math.min(w / 1200, h / 800);
      }

      function scaleFactor() {
        return Math.max(0.5, Math.min(rawFactor(), 1));
      }

      function isTooSmall() {
        return rawFactor() < 0.5;
      }

      function applyMode() {
        var m = getMode();
        var l2d = document.getElementById('oml2d-host');
        var nk = document.getElementById('nikke-host');
        var tooSmall = isTooSmall();
        if (l2d) l2d.style.visibility = (m === 'live2d' && !tooSmall) ? 'visible' : 'hidden';
        if (nk) nk.style.visibility = (m === 'viper' && !tooSmall) ? 'visible' : 'hidden';
        var bl = document.getElementById('btn-live2d');
        var bv = document.getElementById('btn-viper');
        if (bl) bl.style.opacity = (m === 'live2d') ? '1' : '0.45';
        if (bv) bv.style.opacity = (m === 'viper') ? '1' : '0.45';
        var popup = document.getElementById('mascot-min-popup');
        if (popup) popup.style.display = tooSmall ? 'block' : 'none';
      }

      function resizeLive2D() {
        if (getMode() !== 'live2d') return;
        if (!window.__oml2d) return;
        try {
          var s = L2D_BASE_SCALE * scaleFactor();
          window.__oml2d.setModelScale(s);
          var size = window.__oml2d.models.modelSize;
          var el = window.__oml2d.stage.element;
          if (el && size && size.width && size.height) {
            el.style.width = size.width + 'px';
            el.style.height = size.height + 'px';
          }
          if (window.__oml2d.pixiApp && window.__oml2d.pixiApp.resize) window.__oml2d.pixiApp.resize();
        } catch (e) {}
      }

      function resizeNikke() {
        var nk = document.getElementById('nikke-host');
        if (nk) nk.style.transform = 'scale(' + scaleFactor() + ')';
      }

      var resizeTimer = null;
      function onResize() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          applyMode();
          if (isTooSmall()) return;
          if (getMode() === 'viper') { resizeNikke(); } else { resizeLive2D(); }
        }, 120);
      }

      function ensureLive2D() {
        if (window.__oml2d_loaded) { applyMode(); resizeLive2D(); return; }
        window.__oml2d_loaded = true;
        var s = document.createElement('script');
        s.id = 'oml2d-script';
        s.src = (document.body.dataset.base || '/') + 'live2d/index.min.js';
        s.onload = function () {
          if (window.OML2D && window.OML2D.loadOml2d) {
            var models = [];
            for (var i = 0; i < L2D_MODELS.length; i++) {
              models.push({ name: L2D_MODELS[i].name, path: L2D_MODELS[i].path, scale: L2D_BASE_SCALE });
            }
            window.__oml2d = window.OML2D.loadOml2d({ parentElement: document.getElementById('oml2d-host'), dockedPosition: 'right', mobileDisplay: true, models: models });
            setTimeout(bindLive2DClick, 600);
            setTimeout(resizeLive2D, 300);
          }
        };
        s.async = true;
        document.body.appendChild(s);
      }

      function ensureNikke() {
        if (window.__nikke_loaded) { applyMode(); resizeNikke(); return; }
        window.__nikke_loaded = true;
        var s = document.createElement('script');
        s.id = 'spine-script';
        s.src = (document.body.dataset.base || '/') + 'spine/spine-player.js';
        s.onload = function () { initNikke(); };
        s.async = true;
        document.body.appendChild(s);
      }

      function initNikke() {
        if (window.__nikke_inited) { applyMode(); resizeNikke(); return; }
        window.__nikke_inited = true;
        createNikkePlayer();
      }

      function createNikkePlayer() {
        var host = document.getElementById('nikke-host');
        if (!host || !window.spine || !window.spine.SpinePlayer) return;
        var base = (document.body.dataset.base || '/') + 'nikke/' + NIKKE_CUR + '/' + NIKKE_CUR + '_00';
        host.innerHTML = '';
        var c = document.createElement('div');
        c.id = 'nikke-container';
        c.style.cssText = 'width:100%;height:100%;';
        host.appendChild(c);
        try {
          window.__nikke_player = new window.spine.SpinePlayer('nikke-container', {
            skelUrl: base + '.skel',
            atlasUrl: base + '.atlas',
            animation: 'idle',
            skin: 'default',
            backgroundColor: '#00000000',
            alpha: true,
            mipmaps: false,
            debug: false,
            preserveDrawingBuffer: true,
            showControls: false,
            viewport: { padLeft: '0%', padRight: '0%', padTop: '0%', padBottom: '0%' },
            success: function (player) {
              var d = player.skeleton && player.skeleton.data;
              if (d && d.width && d.height) {
                var targetW = Math.round(NIKKE_BASE_H * (d.width / d.height));
                var curW = host.clientWidth || 360;
                if (Math.abs(targetW - curW) > 6 && !window.__nikke_refit_count) {
                  window.__nikke_refit_count = 1;
                  host.style.width = targetW + 'px';
                  host.style.height = NIKKE_BASE_H + 'px';
                  try { player.dispose(); } catch (e) {}
                  createNikkePlayer();
                  return;
                }
              }
              setupNikkeInteraction(player);
              resizeNikke();
            }
          });
        } catch (e) { console.error('nikke init failed', e); }
      }

      function bindLive2DClick() {
        if (window.__l2d_click_bound) return;
        var o = window.__oml2d;
        var stage = o && o.stage && o.stage.element;
        if (!stage) return;
        window.__l2d_click_bound = true;
        stage.addEventListener('click', function (e) {
          if (window.__spawnFlowers) window.__spawnFlowers(e.clientX, e.clientY, 10);
        });
      }

      function setupNikkeInteraction(player) {
        try {
          if (window.spine.CameraController && player.canvas && player.sceneRenderer) {
            new window.spine.CameraController(player.canvas, player.sceneRenderer.camera);
          }
        } catch (e) {}
        try {
          var cv = player.canvas;
          if (!cv || cv.__nikke_click_bound) return;
          cv.__nikke_click_bound = true;
          var downX = 0, downY = 0;
          cv.addEventListener('mousedown', function (e) { downX = e.clientX; downY = e.clientY; });
          cv.addEventListener('mouseup', function (e) {
            var dx = e.clientX - downX, dy = e.clientY - downY;
            if (dx * dx + dy * dy < 49) {
              playNikkeExpression(player);
              if (window.__spawnFlowers) window.__spawnFlowers(e.clientX, e.clientY, 10);
            }
          });
        } catch (e) {}
      }

      function playNikkeExpression(player) {
        try {
          var anims = player.skeleton && player.skeleton.data && player.skeleton.data.animations;
          if (!anims || !anims.length) return;
          var pool = [];
          for (var i = 0; i < anims.length; i++) {
            var n = (anims[i] && anims[i].name) || '';
            if (!n || n === 'idle' || /tap|attack|skill|burst|dodge|move|run|walk|damage|dead/i.test(n)) continue;
            pool.push(n);
          }
          if (!pool.length) {
            for (var j = 0; j < anims.length; j++) {
              var n2 = (anims[j] && anims[j].name) || '';
              if (n2 && n2 !== 'idle') pool.push(n2);
            }
          }
          if (!pool.length) return;
          var pick = pool[Math.floor(Math.random() * pool.length)];
          player.setAnimation(pick, false);
          player.addAnimation('idle', true, 0);
        } catch (e) {}
      }

      function switchLive2D(index) {
        var o = window.__oml2d;
        if (!o || !o.loadModelByIndex) return;
        try {
          var p = o.loadModelByIndex(index);
          if (p && p.then) p.then(function () { setTimeout(resizeLive2D, 200); });
          else setTimeout(resizeLive2D, 600);
        } catch (e) {}
      }

      function switchNikke(id) {
        if (id === NIKKE_CUR) return;
        NIKKE_CUR = id;
        window.__nikke_refit_count = 0;
        if (window.__nikke_player) { try { window.__nikke_player.dispose(); } catch (e) {} }
        createNikkePlayer();
      }

      function renderCharPanel() {
        var panel = document.getElementById('char-panel');
        if (!panel) return;
        var m = getMode();
        var list = m === 'viper' ? NIKKE_CHARS : L2D_MODELS;
        panel.innerHTML = '';
        for (var i = 0; i < list.length; i++) {
          (function (idx) {
            var b = document.createElement('button');
            b.type = 'button';
            b.textContent = list[idx].name;
            b.style.cssText = 'cursor:pointer;border:none;border-radius:8px;padding:5px 12px;color:#fff;background:rgba(255,255,255,.14);font-size:12px;text-align:left;white-space:nowrap';
            b.onclick = function () {
              if (m === 'viper') switchNikke(NIKKE_CHARS[idx].id);
              else switchLive2D(idx);
              hideCharPanel();
            };
            panel.appendChild(b);
          })(i);
        }
      }

      function toggleCharPanel() {
        var panel = document.getElementById('char-panel');
        if (!panel) return;
        if (panel.style.display === 'none' || panel.style.display === '') {
          renderCharPanel();
          panel.style.display = 'flex';
        } else {
          panel.style.display = 'none';
        }
      }

      function hideCharPanel() {
        var panel = document.getElementById('char-panel');
        if (panel) panel.style.display = 'none';
      }

      function bindButtons() {
        var bl = document.getElementById('btn-live2d');
        var bv = document.getElementById('btn-viper');
        var bc = document.getElementById('btn-chars');
        if (bl) bl.onclick = function () { setMode('live2d'); };
        if (bv) bv.onclick = function () { setMode('viper'); };
        if (bc) bc.onclick = function () { toggleCharPanel(); };
      }

      bindButtons();
      applyMode();
      window.addEventListener('resize', onResize);
      if (getMode() === 'viper') { ensureNikke(); } else { ensureLive2D(); }
    })();
  </script>

  <script>
            // ===== 阅读进度条（左侧竖条 + 渐变）=====
    (function () {
      var fill = document.getElementById('progress-fill');
      if (!fill) return;
      function update() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        var pct = max > 0 ? h.scrollTop / max : 0;
        fill.style.height = (pct * 100) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();
// ===== 图片灯箱（点击文章内图片放大）=====
    (function () {
      var overlay = null;
      function close() { if (overlay) { overlay.remove(); overlay = null; } }
      document.addEventListener('click', function (e) {
        var img = e.target && e.target.closest ? e.target.closest('#post-content img') : null;
        if (!img || img.closest('a')) return;
        close();
        overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;cursor:zoom-out;padding:40px';
        var big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.style.cssText = 'max-width:100%;max-height:100%;object-fit:contain;border-radius:8px;background:#fff';
        overlay.appendChild(big);
        overlay.addEventListener('click', close);
        document.body.appendChild(overlay);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();

    // ===== 中英文自动加空格 =====
    (function () {
      function addSpaces(root) {
        if (!root) return;
        var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode: function (node) {
            var p = node.parentElement;
            if (p && (p.closest('pre') || p.closest('code') || p.closest('script') || p.closest('style'))) return NodeFilter.FILTER_REJECT;
            return NodeFilter.FILTER_ACCEPT;
          }
        });
        var nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);
        nodes.forEach(function (node) {
          var v = node.nodeValue;
          if (!v) return;
          var out = v
            .replace(/([\u4e00-\u9fa5\u3040-\u30ff])([A-Za-z0-9])/g, '$1 $2')
            .replace(/([A-Za-z0-9])([\u4e00-\u9fa5\u3040-\u30ff])/g, '$1 $2');
          if (out !== v) node.nodeValue = out;
        });
      }
      function run() { addSpaces(document.querySelector('#post-content') || document.body); }
      document.addEventListener('astro:after-swap', run);
      run();
    })();

                // ===== 鼠标点击：花朵散落（自托管樱花 SVG）=====
    (function () {
      var canvas = document.getElementById('click-particles');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var petals = [];
      var img = new Image();
      img.src = (document.body.dataset.base || '/') + 'flowers/cherry-blossom.svg';
      function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
      resize();
      window.addEventListener('resize', resize, { passive: true });
            function spawn(x, y, n) {
        for (var i = 0; i < n; i++) {
          var a = Math.random() * Math.PI * 2;
          var sp = 1.5 + Math.random() * 3;
          petals.push({
            x: x, y: y,
            vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 1.5,
            rot: Math.random() * Math.PI * 2, vr: (Math.random() - 0.5) * 0.25,
            life: 1, decay: 0.010 + Math.random() * 0.012,
            size: 26 + Math.random() * 18
          });
        }
      }
      window.__spawnFlowers = spawn;
      document.addEventListener('click', function (e) {
        spawn(e.clientX, e.clientY, 4 + Math.floor(Math.random() * 3));
      });
      function draw(p) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.drawImage(img, -p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
      }
      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        petals = petals.filter(function (p) { return p.life > 0 && p.y < canvas.height + 40; });
        petals.forEach(function (p) {
          p.x += p.vx; p.y += p.vy; p.vy += 0.05; p.vx *= 0.99;
          p.rot += p.vr; p.life -= p.decay;
          draw(p);
        });
        ctx.globalAlpha = 1;
        requestAnimationFrame(loop);
      }
      loop();
    })();</script>
</body>
</html>