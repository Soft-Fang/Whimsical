---
// 关于我页面
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="关于我">
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">ABOUT / 关于我</p>
    <h1 class="text-3xl font-bold mb-8">关于我</h1>
    <p class="mt-6 text-fg/70 leading-relaxed">
      {site.about}
    </p>
    <div class="mt-10 space-y-4 text-fg/60">
      <p>📬 GitHub: <a href={`https://github.com/${site.author.github}`} class="text-accent hover:underline">@{site.author.github}</a></p>
      <p>📍 {site.author.location}</p>
    </div>
  </div>
</BaseLayout>
