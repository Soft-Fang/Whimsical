---
// 首页 - 网站主页
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimateIn from '../components/AnimateIn.astro';
import { site } from '../site.config';

const siteUrl = site.url || 'https://example.com';
---

<BaseLayout
  title="首页"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        name: site.name,
        url: siteUrl,
        description: site.description,
      },
      {
        '@type': 'Person',
        name: site.author.name,
        url: siteUrl,
        sameAs: [`https://github.com/${site.author.github}`],
      },
    ],
  }}
>
    <div class="max-w-4xl mx-auto px-6 pt-24 pb-16">
        <AnimateIn>
        <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">WELCOME / 欢迎</p>
        </AnimateIn>
    </div>

</BaseLayout>