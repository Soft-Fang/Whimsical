---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const apps = (await getCollection('apps'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---
<Base title="首页" description="我的学习笔记、技术文章与应用介绍">
  <section class="hero">
    <h1>你好，欢迎来到我的博客 👋</h1>
    <p>这里存放我的学习文档、技术文章，以及我做过的应用介绍与链接。</p>
  </section>

  <section>
    <div class="section-head">
      <h2>最新文章</h2>
      <a class="more" href={base + 'blog/'}>查看全部 →</a>
    </div>
    <div class="grid">
      {posts.map((post) => (
        <a class="card" href={base + 'blog/' + post.id + '/'}>
          <h3>{post.data.title}</h3>
          <time>{post.data.date}</time>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>我的应用</h2>
      <a class="more" href={base + 'apps/'}>查看全部 →</a>
    </div>
    <div class="grid">
      {apps.map((app) => (
        <a class="card" href={base + 'apps/' + app.id + '/'}>
          <h3>{app.data.name}</h3>
          <p>{app.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
