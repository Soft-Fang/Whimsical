---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { site } from '../site.config';

const siteUrl = site.url || 'https://example.com';
const base = import.meta.env.BASE_URL;

const blogPosts = await getCollection('blog');
const talks = await getCollection('talk');
const apps = await getCollection('apps');

const allDates: string[] = [
  ...blogPosts.map((p) => p.data.pubDate),
  ...talks.map((t) => t.data.update ?? ''),
].filter(Boolean).sort();

const totalChars = [...blogPosts, ...talks].reduce((n, e) => n + ((e as any).body?.length ?? 0), 0);
const tagSet = new Set<string>();
blogPosts.forEach((p) => (p.data.tags ?? []).forEach((t) => tagSet.add(t)));

const stats = [
  { label: '文章', value: blogPosts.length, from: '#F06292', to: '#A855F7', d: 'M8 3h6l4 4v14H8zM14 3v4h4' },
  { label: '随笔', value: talks.length, from: '#A855F7', to: '#22D3EE', d: 'M4 20l4-1L19 8l-3-3L5 16zM15.5 6.5l2 2' },
  { label: '标签', value: tagSet.size, from: '#22D3EE', to: '#34D399', d: 'M3 12.5L12.5 3H21v8.5L11.5 21zM16.5 7.5a1.4 1.4 0 1 0 .01 0' },
  { label: '总字数', value: totalChars, from: '#FBBF24', to: '#F06292', d: 'M5 4h6v16H5zM13 4h6v16h-6z' },
];

// ── 写作热力图（近期：近 24 周 ≈ 半年）──
function fmt(d: Date) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
const dateCount: Record<string, number> = {};
allDates.forEach((d) => { const k = d.slice(0, 10); dateCount[k] = (dateCount[k] || 0) + 1; });

const WEEKS = 24;
const today = new Date(); today.setHours(0, 0, 0, 0);
const cursor = new Date(today);
cursor.setDate(today.getDate() - (WEEKS - 1) * 7 - today.getDay());
const weeks: { date: string; count: number }[][] = [];
for (let w = 0; w < WEEKS; w++) {
  const col: { date: string; count: number }[] = [];
  for (let d = 0; d < 7; d++) {
    const k = fmt(cursor);
    col.push({ date: k, count: dateCount[k] || 0 });
    cursor.setDate(cursor.getDate() + 1);
  }
  weeks.push(col);
}
function cellBg(c: number) {
  if (c === 0) return 'color-mix(in srgb, var(--c-fg) 7%, transparent)';
  if (c === 1) return '#F0629266';
  if (c === 2) return '#A855F7aa';
  if (c === 3) return '#A855F7';
  return '#22D3EE';
}
const monthMarks: { idx: number; text: string }[] = [];
let lastMonth = '';
weeks.forEach((w, i) => {
  const m = w[0].date.slice(0, 7);
  if (m !== lastMonth) { monthMarks.push({ idx: i, text: Number(m.slice(5, 7)) + '月' }); lastMonth = m; }
});

// ── 多层嵌套圆环（运动环风格）──
const ringTypes = [
  { label: '正文', value: blogPosts.length, color: '#F06292' },
  { label: '随笔', value: talks.length, color: '#A855F7' },
  { label: '应用', value: apps.length, color: '#22D3EE' },
];
const ringTotal = ringTypes.reduce((n, s) => n + s.value, 0) || 1;
const rings = ringTypes.map((s, i) => ({ ...s, pct: (s.value / ringTotal) * 100, r: 42 - i * 13 }));

// ── 最新文章 ──
const latest = [...blogPosts].sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate)).slice(0, 4);
const imgModules = import.meta.glob('/src/assets/**/*.{jpg,jpeg,png,webp}', { eager: true });
const imgList = [];
for (const mod of Object.values(imgModules)) { if (mod && mod.default) imgList.push(mod.default); }
async function thumb(i: number) {
  if (!imgList.length) return null;
  try { const opt = await getImage({ src: imgList[i % imgList.length], width: 320, format: 'webp' }); return opt.src; } catch (e) { return null; }
}
const cards = [];
for (let i = 0; i < latest.length; i++) cards.push({ post: latest[i], index: i, image: await thumb(i) });
---
<BaseLayout
  title="首页"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'WebSite', name: site.name, url: siteUrl, description: site.description },
      { '@type': 'Person', name: site.author.name, url: siteUrl, sameAs: ['https://github.com/' + site.author.github] },
    ],
  }}
>
  <section class="relative min-h-screen flex flex-col items-center justify-center px-6 text-center overflow-hidden">
    <div id="hero-content" style="will-change: transform, opacity;">
      <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">WELCOME / 欢迎</p>
      <h1 class="text-4xl md:text-6xl font-bold">{site.name}</h1>
      <p class="mt-5 text-lg text-fg/60 max-w-xl mx-auto">{site.description}</p>
    </div>
  </section>

  <div id="scroll-hint" class="fixed bottom-8 left-0 right-0 flex justify-center pointer-events-none transition-opacity duration-300">
    <a href="#status" class="pointer-events-auto p-2 text-fg/40 hover:text-accent" aria-label="向下滚动">
      <span class="inline-block animate-bounce">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7" /></svg>
      </span>
    </a>
  </div>

  <section id="status" class="max-w-4xl mx-auto px-6 pb-16">
    <div class="reveal">
      <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">STATUS / 数据面板</p>
      <h2 class="text-3xl font-bold mb-2">记录的一些数字</h2>
      <span class="mb-8 block h-[3px] w-20 rounded-full" style="background:linear-gradient(90deg,#F06292,#A855F7,#22D3EE)"></span>
    </div>

    <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="anime-stat reveal relative overflow-hidden rounded-2xl ring-1 ring-fg/10 bg-bg/55 backdrop-blur-xl p-4">
          <span class="pointer-events-none absolute left-0 top-0 h-full w-[3px]" style={`background:linear-gradient(180deg,${s.from},${s.to})`}></span>
          <svg class="mb-2.5 h-6 w-6" viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style={`color:${s.from}`}>
            <path d={s.d} stroke="currentColor" />
          </svg>
          <div class="count-up text-2xl font-black leading-none tabular-nums" data-target={s.value} style={`background:linear-gradient(135deg,${s.from},${s.to});-webkit-background-clip:text;background-clip:text;color:transparent`}>0</div>
          <div class="mt-1.5 text-[11px] text-fg/45">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="anime-stat reveal overflow-hidden rounded-2xl ring-1 ring-fg/10 bg-bg/55 backdrop-blur-xl p-5">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <p class="text-[11px] uppercase tracking-[0.2em] text-fg/40">HEATMAP · 近期写作</p>
          <span class="text-[11px] text-fg/35">近 {WEEKS} 周</span>
        </div>
        <div class="overflow-x-auto pb-1">
          <div class="inline-flex flex-col gap-1.5">
            <div class="flex gap-[3px] pl-[1px]">
              {weeks.map((w, i) => {
                const mark = monthMarks.find((mm) => mm.idx === i);
                return <span class="w-[11px] text-[9px] leading-none text-fg/35">{mark ? mark.text : ''}</span>;
              })}
            </div>
            <div class="flex gap-[3px]">
              {weeks.map((w) => (
                <div class="flex flex-col gap-[3px]">
                  {w.map((d) => (
                    <span class="h-[11px] w-[11px] rounded-[2px]" style={`background:${cellBg(d.count)}`} title={`${d.date} · ${d.count} 篇`}></span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-end gap-1.5 text-[10px] text-fg/35">
          <span>少</span>
          <span class="h-[10px] w-[10px] rounded-[2px]" style="background:color-mix(in srgb, var(--c-fg) 7%, transparent)"></span>
          <span class="h-[10px] w-[10px] rounded-[2px]" style="background:#F0629266"></span>
          <span class="h-[10px] w-[10px] rounded-[2px]" style="background:#A855F7aa"></span>
          <span class="h-[10px] w-[10px] rounded-[2px]" style="background:#A855F7"></span>
          <span class="h-[10px] w-[10px] rounded-[2px]" style="background:#22D3EE"></span>
          <span>多</span>
        </div>
      </div>

      <div class="anime-stat reveal rounded-2xl ring-1 ring-fg/10 bg-bg/55 backdrop-blur-xl p-5">
        <p class="mb-3 text-[11px] uppercase tracking-[0.2em] text-fg/40">CONTENT MIX · 内容构成</p>
        <div class="flex items-center gap-5">
          <svg viewBox="0 0 100 100" class="h-36 w-36 shrink-0">
            {rings.map((ring) => (
              <g transform="rotate(-90 50 50)">
                <circle cx="50" cy="50" r={ring.r} fill="none" stroke="color-mix(in srgb, var(--c-fg) 8%, transparent)" stroke-width="9" />
                <circle class="ring-fill" cx="50" cy="50" r={ring.r} fill="none" stroke={ring.color} stroke-width="9" stroke-linecap="round"
                  pathLength="100" stroke-dasharray={`${ring.pct} ${100 - ring.pct}`} />
              </g>
            ))}
          </svg>
          <div class="flex flex-col gap-3">
            {rings.map((ring) => (
              <div class="flex items-center gap-2.5 text-sm">
                <span class="h-2.5 w-2.5 rounded-full" style={`background:${ring.color}`}></span>
                <span class="text-fg/70">{ring.label}</span>
                <span class="font-mono text-xs text-fg/40">{ring.value} 篇 · {Math.round(ring.pct)}%</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="latest" class="max-w-2xl mx-auto px-6 pb-20">
    <div class="reveal">
      <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">LATEST / 最新文章</p>
      <div class="mb-2 flex items-end gap-3">
        <h2 class="text-3xl font-bold">最新文章</h2>
        <a href={base + 'posts'} class="mb-1 text-sm text-fg/40 hover:text-accent transition-colors">全部 →</a>
      </div>
      <span class="mb-8 block h-[3px] w-20 rounded-full" style="background:linear-gradient(90deg,#F06292,#A855F7,#22D3EE)"></span>
    </div>

    {cards.length === 0 ? (
      <p class="text-sm text-fg/40">还没有文章。</p>
    ) : (
      <div class="flex flex-col gap-3.5">
        {cards.map((row) => (
          <div class="reveal">
            <PostCard
              href={base + 'blog/' + row.post.id}
              title={row.post.data.title}
              date={row.post.data.pubDate}
              tags={row.post.data.tags ?? []}
              index={row.index}
              image={row.image}
            />
          </div>
        ))}
      </div>
    )}

    <div class="reveal mt-10">
      <a href={base + 'posts'} class="text-sm text-accent hover:underline">查看全部文章 →</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(48px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-in { opacity: 1; transform: translateY(0); }
  .anime-stat { transition: transform .3s ease, box-shadow .3s ease; }
  .anime-stat:hover { transform: translateY(-3px); box-shadow: 0 14px 34px -16px rgba(168,85,247,.55); }
  .anime-stat span[title] { transition: transform .15s ease; }
  .anime-stat span[title]:hover { transform: scale(1.35); }
  .ring-fill { animation: ringDraw 1.1s cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes ringDraw { from { stroke-dasharray: 0 100; } }
  @media (prefers-reduced-motion: reduce) {
    .reveal { transition: none; opacity: 1; transform: none; }
    .ring-fill { animation: none; }
  }
</style>

<script>
  const heroContent = document.getElementById('hero-content');
  const hint = document.getElementById('scroll-hint');
  function onScroll() {
    const y = window.scrollY;
    if (heroContent) {
      heroContent.style.transform = 'translateY(' + (y * 0.35) + 'px)';
      heroContent.style.opacity = String(Math.max(0, 1 - y / 420));
    }
    if (hint) {
      const gone = y > 30;
      hint.classList.toggle('opacity-0', gone);
      hint.classList.toggle('pointer-events-none', gone);
      hint.style.transform = 'translateY(' + (y * 0.6) + 'px)';
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); } });
    }, { threshold: 0.12 });
    reveals.forEach(function (el) { io.observe(el); });
  } else {
    reveals.forEach(function (el) { el.classList.add('is-in'); });
  }

  function countUp(el) {
    const target = parseInt(el.getAttribute('data-target') || '0', 10);
    const dur = 900;
    let start = null;
    function tick(now) {
      if (start === null) start = now;
      const t = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(target * eased).toLocaleString();
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  const counters = document.querySelectorAll('.count-up');
  if ('IntersectionObserver' in window) {
    const io2 = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { countUp(en.target); io2.unobserve(en.target); } });
    }, { threshold: 0.4 });
    counters.forEach(function (el) { io2.observe(el); });
  } else {
    counters.forEach(function (el) { el.textContent = parseInt(el.getAttribute('data-target') || '0', 10).toLocaleString(); });
  }
</script>