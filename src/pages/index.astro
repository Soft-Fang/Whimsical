---
// 首页：首屏 Hero（壁纸背景）+ 向下滚动提示 + 最新文章
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimateIn from '../components/AnimateIn.astro';
import ReadFrostedGlass from '../components/ReadFrostedGlass.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';

const siteUrl = site.url || 'https://example.com';
const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  .slice(0, 5);
---
<BaseLayout
  title="首页"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'WebSite', name: site.name, url: siteUrl, description: site.description },
      { '@type': 'Person', name: site.author.name, url: siteUrl, sameAs: ['https://github.com/' + site.author.github] },
    ],
  }}
>
  <section class="relative min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <AnimateIn>
      <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">WELCOME / 欢迎</p>
      <h1 class="text-4xl md:text-6xl font-bold">{site.name}</h1>
      <p class="mt-5 text-lg text-fg/60 max-w-xl mx-auto">{site.description}</p>
    </AnimateIn>

    <a href="#latest" class="absolute bottom-8 left-1/2 -translate-x-1/2 p-2 text-fg/40 hover:text-accent transition-colors animate-bounce" aria-label="向下滚动">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </section>

  <section id="latest" class="max-w-2xl mx-auto px-6 pb-20">
    <AnimateIn>
      <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">LATEST / 最新文章</p>
      <h2 class="text-3xl font-bold mb-8">最新文章</h2>
    </AnimateIn>

    <div class="flex flex-col gap-4">
      {posts.map((post, i) => (
        <AnimateIn delay={i * 80}>
          <a href={base + 'blog/' + post.id} class="block group transition-all duration-300 hover:-translate-y-0.5">
            <ReadFrostedGlass>
              <h3 class="text-lg font-bold text-fg group-hover:text-accent transition-colors duration-200 leading-snug">{post.data.title}</h3>
              <p class="mt-2 text-sm text-fg/50 leading-relaxed line-clamp-2">{post.data.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                <time datetime={post.data.pubDate} class="text-xs text-fg/35 font-mono">{post.data.pubDate}</time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => <span class="text-xs text-fg/40">#{tag}</span>)}
                  </div>
                )}
              </div>
            </ReadFrostedGlass>
          </a>
        </AnimateIn>
      ))}
    </div>

    <div class="mt-10">
      <a href={base + 'blog'} class="text-sm text-accent hover:underline">查看全部文章 →</a>
    </div>
  </section>
</BaseLayout>