---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

const base = import.meta.env.BASE_URL;

// 专题 = 文件夹（集合）：blog 正文 / talk 随笔 / apps 应用
export async function getStaticPaths() {
  const TOPICS = [
    { slug: 'article', name: '正文', type: 'blog' },
    { slug: 'essay', name: '随笔', type: 'talk' },
    { slug: 'apps', name: '应用', type: 'apps' },
  ];
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;

const blogPosts = topic.type === 'blog'
  ? (await getCollection('blog')).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  : [];

const talks = topic.type === 'talk'
  ? (await getCollection('talk')).sort((a, b) => (b.data.update ?? '').localeCompare(a.data.update ?? ''))
  : [];

const apps = topic.type === 'apps'
  ? (await getCollection('apps')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  : [];

// 二次元插画缩略图池（复用仓库已有素材）
const imgModules = import.meta.glob('/src/assets/**/*.{jpg,jpeg,png,webp}', { eager: true });
const imgList = [];
for (const mod of Object.values(imgModules)) {
  if (mod && mod.default) imgList.push(mod.default);
}
async function thumb(i: number) {
  if (!imgList.length) return null;
  try {
    const opt = await getImage({ src: imgList[i % imgList.length], width: 320, format: 'webp' });
    return opt.src;
  } catch (e) { return null; }
}

// 精简文本：只留一句 / 几个字
function brief(s: string | undefined, n = 18) {
  const t = (s ?? '').replace(/\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, n) + '…' : t;
}

function fromBody(body: string | undefined, n = 18) {
  const text = (body ?? '')
    .replace(/!\[.*?\]\(.*?\)/g, ' ')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/[#>*`_~-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return brief(text, n);
}

const count = topic.type === 'blog' ? blogPosts.length : topic.type === 'talk' ? talks.length : apps.length;
---
<BaseLayout title={topic.name} description={'专题：' + topic.name}>
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">TOPIC / 专题</p>
    <div class="mb-2 flex items-end gap-3">
      <h1 class="text-3xl font-bold">{topic.name}</h1>
      <span class="mb-1 font-mono text-xs text-fg/35">{String(count).padStart(2, '0')} 篇</span>
    </div>
    <span class="mb-4 block h-[3px] w-20 rounded-full" style="background:linear-gradient(90deg,#F06292,#A855F7,#22D3EE)"></span>
    <a href={base + 'topics'} class="text-sm text-fg/40 hover:text-accent transition-colors">← 返回专题</a>

    {topic.type === 'blog' && (
      <div class="mt-8 flex flex-col gap-3.5">
        {blogPosts.length === 0 ? (
          <p class="text-sm text-fg/40">暂无文章</p>
        ) : (
          await Promise.all(blogPosts.map(async (p, i) => (
            <PostCard
              href={base + 'blog/' + p.id}
              title={p.data.title}
              date={p.data.pubDate}
              tags={p.data.tags ?? []}
              index={i}
              image={await thumb(i)}
            />
          )))
        )}
      </div>
    )}

    {topic.type === 'talk' && (
      <div class="mt-8 flex flex-col gap-3.5">
        {talks.length === 0 ? (
          <p class="text-sm text-fg/40">暂无随笔</p>
        ) : (
          await Promise.all(talks.map(async (t, i) => (
            <PostCard
              href={base + 'talk/' + t.id}
              title={t.data.title ?? t.id}
              date={t.data.update}
              index={i}
              image={await thumb(i)}
            />
          )))
        )}
      </div>
    )}

    {topic.type === 'apps' && (
      <div class="mt-8 flex flex-col gap-3.5">
        {apps.length === 0 ? (
          <p class="text-sm text-fg/40">暂无应用</p>
        ) : (
          await Promise.all(apps.map(async (a, i) => (
            <PostCard
              href={a.data.url ?? a.data.repo ?? '#'}
              title={a.data.name}
              tags={a.data.tags ?? []}
              index={i}
              image={await thumb(i)}
            />
          )))
        )}
      </div>
    )}
  </div>
</BaseLayout>