---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const TOPICS = [
    { slug: 'essay', name: '随笔', type: 'blog', category: '随笔' },
    { slug: 'diary', name: '不定期日记', type: 'blog', category: '不定期日记' },
    { slug: 'review', name: '复盘笔记', type: 'blog', category: '复盘笔记' },
    { slug: 'apps', name: '应用', type: 'apps' },
  ];
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;

const blogPosts = topic.type === 'blog'
  ? (await getCollection('blog'))
      .filter((p) => p.data.category === topic.category)
      .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
  : [];

const apps = topic.type === 'apps'
  ? (await getCollection('apps')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  : [];
---
<BaseLayout title={topic.name} description={'专题：' + topic.name}>
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">TOPIC / 专题</p>
    <h1 class="text-3xl font-bold mb-2">{topic.name}</h1>
    <a href={base + 'topics'} class="text-sm text-fg/40 hover:text-accent transition-colors">← 返回专题</a>

    {topic.type === 'blog' ? (
      <div class="mt-8 flex flex-col gap-3">
        {blogPosts.length === 0 ? (
          <p class="text-sm text-fg/40">暂无文章</p>
        ) : (
          blogPosts.map((p) => (
            <a href={base + 'blog/' + p.id} class="block p-5 rounded-2xl border border-fg/8 bg-bg/60 backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5">
              <h2 class="text-base font-bold text-fg">{p.data.title}</h2>
              <p class="mt-1 text-sm text-fg/50 leading-relaxed">{p.data.description}</p>
              <time datetime={p.data.pubDate} class="mt-2 inline-block text-xs text-fg/35 font-mono">{p.data.pubDate}</time>
            </a>
          ))
        )}
      </div>
    ) : (
      <div class="mt-8 flex flex-col gap-3">
        {apps.length === 0 ? (
          <p class="text-sm text-fg/40">暂无应用</p>
        ) : (
          apps.map((a) => (
            <div class="p-5 rounded-2xl border border-fg/8 bg-bg/60 backdrop-blur-xl">
              <h2 class="text-base font-bold text-fg">{a.data.name}</h2>
              <p class="mt-1 text-sm text-fg/50 leading-relaxed">{a.data.description}</p>
              {a.data.tags && a.data.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {a.data.tags.map((tag) => <span class="text-xs text-accent bg-accent/10 px-2.5 py-1 rounded-full">#{tag}</span>)}
                </div>
              )}
              <div class="mt-3 flex gap-4">
                {a.data.url && <a href={a.data.url} target="_blank" rel="noopener" class="text-sm text-accent hover:underline">访问应用 →</a>}
                {a.data.repo && <a href={a.data.repo} target="_blank" rel="noopener" class="text-sm text-fg/50 hover:text-accent">源码 ↗</a>}
              </div>
            </div>
          ))
        )}
      </div>
    )}
  </div>
</BaseLayout>