---
import Base from '../../layouts/Base.astro';
import privatePosts from '../../data/private-posts.json';

const dataJson = JSON.stringify(privatePosts);
---
<Base title="私有空间" description="需要密码才能查看的私有内容">
  <section class="private">
    <h1>私有空间 🔒</h1>
    <p class="lead">这里的内容已加密，需要输入密码才能查看。</p>

    <div id="private-data" hidden>{dataJson}</div>

    <div id="private-app">
      <form id="private-form" class="private-form" autocomplete="off">
        <input type="password" id="private-password" placeholder="请输入密码" autocomplete="current-password" required />
        <button type="submit">解锁</button>
      </form>
      <p id="private-msg" class="private-msg" role="alert"></p>
      <div id="private-content" hidden></div>
    </div>
  </section>
</Base>

<script>
  const dataEl = document.getElementById('private-data');
  if (dataEl) {
    const data = JSON.parse(dataEl.textContent.trim());
    const form = document.getElementById('private-form');
    const input = document.getElementById('private-password');
    const msg = document.getElementById('private-msg');
    const content = document.getElementById('private-content');

    function b64ToBytes(str) {
      const bin = atob(str);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return bytes;
    }

    async function deriveKey(password, saltB64, iterations) {
      const keyMaterial = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: b64ToBytes(saltB64), iterations: iterations, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
    }

    async function decryptPost(key, post) {
      const pt = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: b64ToBytes(post.iv) },
        key,
        b64ToBytes(post.ct)
      );
      return JSON.parse(new TextDecoder().decode(pt));
    }

    function render(posts) {
      content.innerHTML = '';
      for (const p of posts) {
        const article = document.createElement('article');
        article.className = 'private-post';
        const title = document.createElement('h2');
        title.textContent = p.title;
        const meta = document.createElement('p');
        meta.className = 'private-meta';
        meta.textContent = [p.date, p.description].filter(Boolean).join(' · ');
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = '阅读全文';
        const body = document.createElement('div');
        body.className = 'prose private-body';
        body.innerHTML = p.html;
        details.appendChild(summary);
        details.appendChild(body);
        article.appendChild(title);
        article.appendChild(meta);
        article.appendChild(details);
        content.appendChild(article);
      }
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const password = input.value;
      if (!password) return;
      msg.textContent = '正在解密…';
      msg.className = 'private-msg';
      try {
        const key = await deriveKey(password, data.kdf.salt, data.kdf.iterations);
        const posts = [];
        for (const p of data.posts) {
          posts.push(await decryptPost(key, p));
        }
        render(posts);
        form.hidden = true;
        msg.hidden = true;
        content.hidden = false;
      } catch (err) {
        console.error(err);
        msg.textContent = '密码错误，请重试。';
        msg.className = 'private-msg error';
        input.select();
      }
    });
  }
</script>
