---
// 404 页面
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <div class="max-w-2xl mx-auto px-6 pt-32 pb-16 text-center">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">404</p>
    <h1 class="text-6xl font-bold text-accent">---------失联中--------</h1>
    <p class="mt-6 text-fg/50 text-lg">你瞎搜索啥呢???</p>
    <a href={import.meta.env.BASE_URL} class="mt-8 inline-block px-6 py-2 rounded-full bg-accent text-white hover:opacity-80 transition-opacity">
      返回首页
    </a>
  </div>
</BaseLayout>
