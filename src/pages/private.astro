---
// 私有空间：内容已加密，输入密码后客户端解密显示
import BaseLayout from '../layouts/BaseLayout.astro';
import privatePosts from '../data/private-posts.json';

const dataJson = JSON.stringify(privatePosts);
---
<BaseLayout title="私有空间">
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">PRIVATE / 私有</p>
    <h1 class="text-3xl font-bold mb-8">私有空间 🔒</h1>
    <p class="text-fg/60">这里的内容已加密，需要输入密码才能查看。</p>

    <div id="private-data" hidden>{dataJson}</div>

    <form id="private-form" class="mt-6 flex gap-3 flex-wrap" autocomplete="off">
      <input
        type="password"
        id="private-password"
        placeholder="请输入密码"
        autocomplete="current-password"
        required
        class="flex-1 min-w-[200px] px-4 py-2 rounded-xl bg-bg/60 ring-1 ring-fg/15 text-fg placeholder:text-fg/30 focus:outline-none focus:ring-accent"
      />
      <button type="submit" class="px-5 py-2 rounded-xl bg-accent text-white hover:opacity-80 transition-opacity">解锁</button>
    </form>
    <p id="private-msg" class="mt-3 text-sm text-fg/50" role="alert"></p>
    <div id="private-content" class="mt-8 space-y-6" hidden></div>
  </div>
</BaseLayout>

<script>
  const dataEl = document.getElementById('private-data');
  if (dataEl) {
    const data = JSON.parse(dataEl.textContent.trim());
    const form = document.getElementById('private-form');
    const input = document.getElementById('private-password');
    const msg = document.getElementById('private-msg');
    const content = document.getElementById('private-content');

    function b64ToBytes(str) {
      const bin = atob(str);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return bytes;
    }

    async function deriveKey(password, saltB64, iterations) {
      const keyMaterial = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: b64ToBytes(saltB64), iterations: iterations, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
    }

    async function decryptPost(key, post) {
      const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64ToBytes(post.iv) }, key, b64ToBytes(post.ct));
      return JSON.parse(new TextDecoder().decode(pt));
    }

    function render(posts) {
      content.innerHTML = '';
      for (const p of posts) {
        const article = document.createElement('article');
        article.className = 'p-6 rounded-2xl bg-bg/60 backdrop-blur-xl ring-1 ring-fg/10';
        const title = document.createElement('h2');
        title.className = 'text-xl font-semibold';
        title.textContent = p.title;
        const meta = document.createElement('p');
        meta.className = 'mt-1 text-sm text-fg/40';
        meta.textContent = [p.date, p.description].filter(Boolean).join(' · ');
        const details = document.createElement('details');
        details.className = 'mt-4';
        const summary = document.createElement('summary');
        summary.className = 'cursor-pointer text-accent text-sm';
        summary.textContent = '阅读全文';
        const body = document.createElement('div');
        body.className = 'mt-4 prose prose-neutral dark:prose-invert max-w-none text-fg/80';
        body.innerHTML = p.html;
        details.appendChild(summary);
        details.appendChild(body);
        article.appendChild(title);
        article.appendChild(meta);
        article.appendChild(details);
        content.appendChild(article);
      }
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const password = input.value;
      if (!password) return;
      msg.textContent = '正在解密…';
      msg.style.color = '';
      try {
        const key = await deriveKey(password, data.kdf.salt, data.kdf.iterations);
        const posts = [];
        for (const p of data.posts) posts.push(await decryptPost(key, p));
        render(posts);
        form.hidden = true;
        msg.hidden = true;
        content.hidden = false;
      } catch (err) {
        console.error(err);
        msg.textContent = '密码错误，请重试。';
        msg.style.color = '#dc2626';
        input.select();
      }
    });
  }
</script>
