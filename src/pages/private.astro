---
import BaseLayout from '../layouts/BaseLayout.astro';
import privatePosts from '../data/private-posts.json';

const base = import.meta.env.BASE_URL;
const dataJson = JSON.stringify(privatePosts);
---
<BaseLayout title="私有空间">
  <div id="private-data" hidden>{dataJson}</div>

  <div id="private-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-6">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-sm rounded-2xl bg-bg ring-1 ring-fg/10 shadow-2xl p-6">
      <p class="text-sm font-semibold mb-3">请输入密码进入私有空间</p>
      <form id="private-form" class="flex flex-col gap-3">
        <input type="password" id="private-password" placeholder="密码" autocomplete="off"
          class="w-full px-4 py-2 rounded-xl bg-bg ring-1 ring-fg/15 text-fg placeholder:text-fg/30 focus:outline-none focus:ring-accent" />
        <p id="private-msg" class="text-sm text-red-500 min-h-[1.25em]"></p>
        <div class="flex justify-end gap-3">
          <a href={base} class="px-4 py-2 text-sm text-fg/50 hover:text-fg">返回首页</a>
          <button type="submit" class="px-5 py-2 rounded-xl bg-accent text-white text-sm hover:opacity-80">进入</button>
        </div>
      </form>
    </div>
  </div>

  <div id="private-content" class="max-w-2xl mx-auto px-6 pt-24 pb-16 hidden"></div>
</BaseLayout>

<script>
(function () {
  const dataEl = document.getElementById('private-data');
  const modal = document.getElementById('private-modal');
  const form = document.getElementById('private-form');
  const input = document.getElementById('private-password');
  const msg = document.getElementById('private-msg');
  const content = document.getElementById('private-content');
  if (!dataEl || !modal || !form) return;

  const data = JSON.parse(dataEl.textContent.trim());

  function b64ToBytes(str) {
    const bin = atob(str);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes;
  }

  async function deriveKey(password) {
    const keyMaterial = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: b64ToBytes(data.kdf.salt), iterations: data.kdf.iterations, hash: 'SHA-256' },
      keyMaterial,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt']
    );
  }

  async function tryDecrypt(password) {
    const key = await deriveKey(password);
    const posts = [];
    for (const p of data.posts) {
      const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64ToBytes(p.iv) }, key, b64ToBytes(p.ct));
      posts.push(JSON.parse(new TextDecoder().decode(pt)));
    }
    return posts;
  }

  function render(posts) {
    content.innerHTML = '';
    const head = document.createElement('div');
    head.innerHTML = '<p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">PRIVATE / 私有</p><h1 class="text-3xl font-bold mb-8">私有空间 🔒</h1>';
    content.appendChild(head);
    for (const p of posts) {
      const article = document.createElement('article');
      article.className = 'p-6 rounded-2xl bg-bg/60 backdrop-blur-xl ring-1 ring-fg/10 mb-5';
      const title = document.createElement('h2');
      title.className = 'text-xl font-semibold';
      title.textContent = p.title;
      const meta = document.createElement('p');
      meta.className = 'mt-1 text-sm text-fg/40';
      meta.textContent = [p.date, p.description].filter(Boolean).join(' · ');
      const details = document.createElement('details');
      details.className = 'mt-4';
      const summary = document.createElement('summary');
      summary.className = 'cursor-pointer text-accent text-sm';
      summary.textContent = '阅读全文';
      const body = document.createElement('div');
      body.className = 'mt-4 prose prose-neutral dark:prose-invert max-w-none text-fg/80';
      body.innerHTML = p.html;
      details.appendChild(summary);
      details.appendChild(body);
      article.appendChild(title);
      article.appendChild(meta);
      article.appendChild(details);
      content.appendChild(article);
    }
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const password = input.value;
    if (!password) return;
    msg.textContent = '验证中…';
    try {
      const posts = await tryDecrypt(password);
      render(posts);
      modal.style.display = 'none';
      content.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      msg.textContent = '密码错误，请重试。';
      input.select();
    }
  });

  input.focus();
})();
</script>