{
  "name": "whimsical",
  "description": "个人博客：Astro 7 + Tailwind CSS 4，部署在 GitHub Pages。主题衍生自 good-looking-basics-blog（MIT）。",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://soft-fang.github.io/Whimsical/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soft-Fang/Whimsical.git"
  },
  "keywords": [
    "astro",
    "blog",
    "tailwindcss",
    "obsidian"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "encrypt": "node scripts/encrypt.mjs",
    "check": "node scripts/check.mjs",
    "check:json": "node scripts/check.mjs --json",
    "compress": "node scripts/compress-images.mjs",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "setup": "node setup/lib/bootstrap.mjs",
    "setup:export": "node setup/lib/export.mjs",
    "setup:docs": "node setup/lib/render-docs.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "katex": "^0.18.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "marked": "^18.0.11"
  }
}
